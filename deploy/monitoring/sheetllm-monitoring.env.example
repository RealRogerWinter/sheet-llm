# sheet-llm host monitoring config. Copy to /etc/sheetllm-monitoring.env,
# chmod 600 (it holds SMTP creds), and fill in. Every key has a sane default in
# lib/common.sh except the alert channel — set at least ONE of:
#   MONITOR_ALERT_EMAIL (+ SMTP_*)   or   MONITOR_WEBHOOK_URL

# --- Alert channel: email (reuses the app's Brevo SMTP creds) ---
MONITOR_ALERT_EMAIL=you@example.com
# Copy these from /opt/sheet-llm/.env (or any SMTP relay):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sheet-llm monitor <noreply@sheetllm.com>

# --- Alert channel: webhook (Slack/Discord/generic). Optional, sent in addition. ---
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/XXX

# --- Behavior ---
# MONITOR_THROTTLE_SEC=21600          # re-alert at most every 6h per check
# MONITOR_STATE_DIR=/var/lib/sheetllm-monitoring

# --- Thresholds (override only if needed) ---
# HEALTH_LOOPBACK_URL=http://127.0.0.1:3000/api/health
# APP_CONTAINER=sheet-llm-app-1
# CADDY_SERVICE=caddy
# DISK_PATHS="/ /var/lib/docker"
# DISK_PCT_MAX=85
# LITESTREAM_LOG_WINDOW=15m
# AOP_CERT_PATH=/etc/caddy/cf-origin-pull-ca.pem
# AOP_MIN_DAYS=21
# CFUFW_SERVICE=cf-ufw-refresh
# CFUFW_MAX_AGE_DAYS=8
