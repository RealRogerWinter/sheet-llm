{
  "name": "sheet-llm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:boundaries": "depcruise src/lib --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/eval/**\" --exclude \"**/evals/**\" --exclude \"**/tests/e2e/**\"",
    "test:watch": "vitest --exclude \"**/eval/**\" --exclude \"**/evals/**\" --exclude \"**/tests/e2e/**\"",
    "test:eval": "vitest run -c vitest.eval.config.ts",
    "eval:mock": "vitest run -c vitest.evals.config.ts",
    "eval:live": "vitest run -c vitest.evals.live.config.ts",
    "eval:smoke": "vitest run -c vitest.evals.smoke.config.ts",
    "eval:visual": "vitest run -c vitest.evals.visual.config.ts",
    "eval:baselines:capture": "tsx scripts/capture-visual-baselines.ts",
    "she15:matrix": "tsx scripts/she15-eval-matrix.ts",
    "she15:converse": "tsx scripts/she15-converse-capture.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "abcjs:spike": "node scripts/abcjs-spike.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "replay": "tsx scripts/replay.ts",
    "backfill:orchestrator-turns": "tsx scripts/backfill-orchestrator-turns.ts",
    "export-training-pairs": "tsx scripts/export-training-pairs.ts",
    "trim:orchestrator-turns": "tsx scripts/trim-orchestrator-turns.ts",
    "trim:training-pairs": "tsx scripts/trim-training-pairs.ts",
    "docs:check": "tsx scripts/docs/check-doc-freshness.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@node-rs/argon2": "^2.0.2",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/note": "^4.12.1",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.6.3",
    "arctic": "^3.7.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.2.0",
    "svg2pdf.js": "^2.7.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
