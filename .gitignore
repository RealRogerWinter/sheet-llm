# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# persistence (local SQLite database files)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
# stray test-DB artifacts (the suite uses in-memory SQLite; these are
# leftover cruft from earlier ad-hoc runs that escaped DATABASE_URL)
/sheet-llm.db
/test-db-shouldnotexist/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local working dirs (agent worktrees, transcripts, caches).
# Ignore the directory's contents but KEEP the committed shared hooks that wire
# chunk's inner-loop validation for every contributor.
.claude/*
!.claude/settings.json

# chunk active-sidecar state (machine-local handles to a running microVM; never
# committed — only .chunk/config.json is). Mirrors what `chunk init` ignores.
.chunk/sidecar.json
.chunk/sidecar.*.json
