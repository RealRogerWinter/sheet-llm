# Required: get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Cloudflare Turnstile bot-gate for the LLM-cost routes (/api/chat, /api/import).
# Active ONLY when BOTH are set — create a widget at dash.cloudflare.com -> Turnstile.
# The site key is PUBLIC (ships to the browser by design); the secret key stays
# server-side (siteverify). Pair with Bot Fight Mode at the edge.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Persistence
#   Dev:  file:./data/sheet-llm.db        (SQLite via better-sqlite3)
#   Prod: postgres://user:pass@host/db    (Postgres via Neon; NOT YET WIRED —
#         the app REJECTS any non-file: URL at boot, so do NOT set this in prod.)
DATABASE_URL=file:./data/sheet-llm.db

# Session-cookie signing key (32+ bytes; base64 ok)
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Recovery-token signing key — MUST be different from SESSION_SECRET so
# the two key materials can be rotated independently. The recovery
# token lives in client-side localStorage (so users survive cookie
# loss); if it leaked, you can rotate RECOVERY_SECRET to invalidate
# every backup token without invalidating any session cookie.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RECOVERY_SECRET=

# Set to "1" ONLY for localhost dev over plain HTTP. The session/CSRF cookies are
# Secure by default, and it ALSO suppresses the HSTS response header (so the dev
# box can't pin HSTS for localhost). Staging/preview/prod on HTTPS never need
# this. If you're tempted to set this anywhere reachable from the network, don't.
SL_INSECURE_COOKIE_OK=

# Set to "1" ONLY on a non-prod box that runs with NODE_ENV=production (e.g. a
# staging build) where you want the debug panel's CLIENT-supplied `generationTier`
# override to take effect. DANGEROUS on anything internet-reachable: it lets a
# caller self-select the `pro` tier and bypass the paywall. Leave unset in prod —
# the override is honored automatically in development/test without this.
SL_ALLOW_TIER_OVERRIDE=

# Accounts master switch. Unset/0 → every /api/auth/* route 404s (the security
# schema + recovery/claim gate + session resolver are ALWAYS live; only the
# user-facing signup/login surface is gated). Set "1" to enable accounts.
SL_ACCOUNTS_ENABLED=

# Number of trusted reverse-proxy hops in front of the app, used to pin the real
# client IP for auth rate limiting (the Nth x-forwarded-for entry from the
# right). Set to 1 behind a single edge/CDN (Fly, Vercel, Cloudflare). Unset →
# leftmost XFF (spoofable) — set this on any internet-facing deployment.
TRUSTED_PROXY_HOPS=

# Transactional email (verification + password reset). Set BOTH to send via
# Resend (https://resend.com); leave EITHER unset to fall back to the console
# provider, which logs the email + link to the server terminal (fine for dev —
# copy the link out of the terminal to complete a flow).
#   EMAIL_FROM must be a Resend-verified sender, e.g. "sheet-llm <noreply@your-domain>"
RESEND_API_KEY=
EMAIL_FROM=

# Absolute base URL used to build links in outbound email (verification/reset).
# Optional: defaults to the request's own origin, which is correct for a
# single-domain dev/v1 deploy. Set it when behind a proxy whose forwarded Origin
# differs from the public URL, e.g. https://app.example.com
APP_BASE_URL=

# OAuth sign-in (Google / GitHub). A provider's button + routes are only active
# when BOTH its id and secret are set — leave them blank to disable that
# provider. Register the callback URL with each provider as:
#   <OAUTH_REDIRECT_BASE_URL or app origin>/api/auth/oauth/google/callback
#   <OAUTH_REDIRECT_BASE_URL or app origin>/api/auth/oauth/github/callback
# GitHub needs the "user:email" scope (requested automatically) so we can read
# the primary VERIFIED email; sign-in is refused if no verified email is present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Absolute base URL for the OAuth callback (must match what's registered with the
# providers). Optional: defaults to the request origin (single-domain dev/v1).
OAUTH_REDIRECT_BASE_URL=

# Paywall: when "1", resolveGenerationTier reads per-user entitlement from
# users.tier — a 'pro' tier WITH a verified email upgrades whole-score generation
# to pro; everyone else stays on the instance default. UPGRADE-only (never
# downgrades below SL_GENERATION_TIER). Unset → instance-wide tier for everyone.
# (Per-user metering + Stripe billing that SET users.tier='pro' are a later
# milestone; this only READS the column.)
SL_ENTITLEMENTS_DB=

# Durability launch gate (Litestream). Set SL_REQUIRE_WAL=1 in prod so a
# non-WAL journal becomes a FATAL boot error (refuses to start unreplicated) —
# turn this on, with Litestream live, BEFORE flipping SL_ACCOUNTS_ENABLED.
# See docs/guides/durability-runbook.md.
SL_REQUIRE_WAL=
# Object-storage replica destination for Litestream (also flips the WAL gate on).
#   e.g. s3://my-bucket/sheet-llm
LITESTREAM_REPLICA_URL=
# Litestream object-storage credentials (or use an instance role / IAM).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ============================================================================
# Daily request quota + abuse gating — HOSTED sheetllm.com ONLY.
# DISABLED BY DEFAULT: leave SL_DAILY_QUOTA_ENABLED unset and the whole layer is
# inert (no quota, no IP checks, no extra DB work) — self-hosted / local installs
# are unaffected. Full design + operator runbook: docs/subsystems/daily-quota.md.
# ============================================================================

# Master toggle for the daily request quota. "1" enforces per-identity daily caps
# on /api/chat (the only token-spending route). Off → no gating.
SL_DAILY_QUOTA_ENABLED=
# Anonymous requests per 24h, keyed on the (pseudonymized) CF-Connecting-IP.
SL_DAILY_QUOTA_ANON=5
# Verified logged-in (non-Pro) requests per 24h, keyed on userId. Unverified
# accounts are treated as anonymous (the SL_DAILY_QUOTA_ANON bucket) until they
# verify their email — this is what makes account-farming pointless.
SL_DAILY_QUOTA_FREE=10
# Window length in seconds (default 24h). Lower for testing/ops.
SL_DAILY_QUOTA_WINDOW_SEC=86400
# OPTIONAL instance-wide anonymous ceiling: total anon requests per window across
# ALL IPs (a single counter). The only control that bounds TOTAL anon spend under
# IP/account rotation — recommended in prod. Unset → off (rely on the Anthropic
# org spend cap as the aggregate backstop).
SL_DAILY_QUOTA_ANON_GLOBAL=
# Fail-OPEN cap on the request_quota row count (bounds disk/Litestream bloat from
# distinct-key spray): past this, NEW anon keys are admitted WITHOUT a row.
SL_DAILY_QUOTA_MAX_ROWS=200000
# IPv6 prefix the anon key collapses to (closes the /64 self-rotation multiplier).
SL_DAILY_QUOTA_V6_PREFIX=56
# Grace (seconds) after a window closes before the anon IP-PII row is reaped.
SL_DAILY_QUOTA_RETENTION_GRACE_SEC=3600

# IP-reputation gate. Master toggle "1" to classify TOR / datacenter-VPN IPs;
# risky ANONYMOUS requests are asked to sign in (not hard-blocked). Header trust is
# gated behind a proven Cloudflare transit (see SL_EDGE_AUTH_SECRET).
SL_IP_RISK_ENABLED=
# Per-signal toggles (effective only when SL_IP_RISK_ENABLED=1):
SL_IP_RISK_TOR=          # treat cf-ipcountry=T1 (Cloudflare's free TOR signal) as risky
SL_IP_RISK_ASN=          # treat a denylisted client ASN as risky (needs the CF Transform Rule)
# Header the CF Transform Rule SETs to ip.geoip.asnum (trusted only on a CF request).
SL_IP_RISK_TRUSTED_ASN_HEADER=x-sl-client-asn
# Version-controlled datacenter/VPN ASN denylist (hot-reloaded via mtime).
SL_IP_RISK_ASN_LIST_PATH=config/ip-risk-asns.json
# CSV escape hatches: extra deny ASNs / allow ASNs (allow beats deny) / allow+deny CIDRs.
SL_IP_RISK_EXTRA_DENY_ASNS=
SL_IP_RISK_ALLOW_ASNS=
SL_IP_RISK_ALLOW_CIDRS=
SL_IP_RISK_DENY_CIDRS=
# "1" to log per-request risk verdicts (hashed IP only). Off by default.
SL_IP_RISK_DEBUG=

# Hosted-only shared secret a Cloudflare Transform Rule SETs as x-sl-edge-auth; the
# origin verifies it so the cf-*/ASN trust boundary (isCfRequest) is independent of
# the CF-IP firewall. Unset → isCfRequest falls back to cf-connecting-ip+cf-ray
# presence (trustworthy ONLY behind the origin lock). Strongly recommended on prod.
SL_EDGE_AUTH_SECRET=

# Operator email that /api/pro-interest sends Pro-waitlist signups to (via the
# Resend seam). Unset → the /pro page falls back to a mailto: link.
SL_PRO_WAITLIST_NOTIFY=
